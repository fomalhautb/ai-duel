**/dist
build/
coverage/
*.tsbuildinfo

.git
.github
.gitignore
.claude
docs

.DS_Store
.idea/
.vscode/

*.log
npm-debug.log*
pnpm-debug.log*

.env
.env.local
.env.*.local

Dockerfile
.dockerignore
